import type {
  EXPERIMENTAL_Router,
  EXPERIMENTAL_RouterOptions,
} from 'vue-smart-router/experimental'

/**
 * Setups hot module replacement for the resolver.
 * Generated by unplugin-vue-smart-router
 *
 * @param router - The router instance
 * @param hotUpdateCallback - Callback to be called after replacing the resolver and before the navigation
 *
 * @example
 *
 * ```ts
 * import { createWebHistory } from 'vue-smart-router'
 * import { experimental_createRouter as createRouter } from 'vue-smart-router/experimental'
 * import { resolver, handleHotUpdate } from 'vue-smart-router/auto-resolver'
 * const router = createRouter({
 *   history: createWebHistory(),
 *   resolver,
 * })
 * if (import.meta.hot) {
 *   handleHotUpdate(router)
 * }
 * ```
 */
export declare function handleHotUpdate(
  router: EXPERIMENTAL_Router,
  hotUpdateCallback?: (
    newResolver: EXPERIMENTAL_RouterOptions['resolver']
  ) => void
): void

/**
 * Custom resolver automatically generated at build time
 * Generated by unplugin-vue-smart-router
 */
export declare const resolver: EXPERIMENTAL_RouterOptions['resolver']

